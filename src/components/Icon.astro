---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.35"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  {(paths[name] ?? paths.spark).map((d) => (
    <path d={d} />
  ))}
  {name === "user" && <circle cx="9" cy="7" r="4" />}
  {name === "award" && <circle cx="12" cy="8" r="6" />}
</svg>
